PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crm_platform?schema=public"
JWT_SECRET="change-me"
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Encrypts businesses' own database URLs, Pusher secrets and storage keys. 64 hex chars: openssl rand -hex 32
CREDENTIALS_KEY=
# false = every business must connect its own database, Pusher app and storage
ALLOW_SHARED_INFRA=true

# The shared Vercel Blob store for dish photos and logos, used by businesses
# that haven't connected their own storage.
BLOB_READ_WRITE_TOKEN=

# true = new owner accounts wait for review until approved in account_approvals
REQUIRE_ACCOUNT_APPROVAL=true
