generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String?         @db.VarChar(255)
  phone          String?         @db.VarChar(20)
  password_hash  String
  full_name      String          @db.VarChar(255)
  is_active      Boolean         @default(true)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  platform_users platform_users?

  @@map("users")
}

model menu_categories {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id String       @db.Uuid
  name        String       @db.VarChar(100)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)
  platforms   platforms    @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_menu_category_platform")
  menu_items  menu_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model menu_items {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id     String           @db.Uuid
  category_id     String?          @db.Uuid
  name            String           @db.VarChar(255)
  description     String?
  price           Decimal          @db.Decimal(12, 2)
  tax_rate        Decimal          @default(0) @db.Decimal(5, 2)
  tax_mode        String           @default("none") @db.VarChar(10)
  tax_name        String?          @db.VarChar(100)
  tax_pct         Decimal?         @db.Decimal(5, 2)
  image_url       String?
  is_vegan        Boolean          @default(false)
  is_available    Boolean          @default(true)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  note            String?
  menu_categories menu_categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_menu_item_category")
  platforms       platforms        @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_menu_item_platform")
  order_lines     order_lines[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model platform_preferences {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id     String    @unique @db.Uuid
  currency        String    @default("EUR") @db.VarChar(3)
  common_tax_rate Decimal   @default(0) @db.Decimal(5, 2)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  platforms       platforms @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_preferences_platform")
}

model platform_types {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String      @unique(map: "unique_platform_type_code") @db.VarChar(50)
  name        String      @db.VarChar(100)
  description String?
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  platforms   platforms[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model platform_users {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id String    @db.Uuid
  user_id     String    @unique(map: "one_platform_per_user") @db.Uuid
  role        String    @db.VarChar(20)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  platforms   platforms @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_platform_users_platform")
  users       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_platform_users_user")

  @@unique([platform_id, user_id], map: "unique_platform_user")
}

model platforms {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_type_id     String                @db.Uuid
  name                 String                @db.VarChar(255)
  description          String?
  phone                String?               @db.VarChar(20)
  email                String?               @db.VarChar(255)
  address              String?
  is_active            Boolean               @default(true)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @default(now()) @db.Timestamptz(6)
  menu_categories      menu_categories[]
  menu_items           menu_items[]
  platform_preferences platform_preferences?
  platform_users       platform_users[]
  platform_types       platform_types        @relation(fields: [platform_type_id], references: [id], onUpdate: NoAction, map: "fk_platform_type")
  special_taxes        special_taxes[]
  tables               tables[]
  orders               orders[]
  bookings             bookings[]
  table_requests       table_requests[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model special_taxes {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id String    @db.Uuid
  name        String    @db.VarChar(100)
  tax_rate    Decimal   @db.Decimal(5, 2)
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  platforms   platforms @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_special_tax_platform")
}

model tables {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id    String           @db.Uuid
  name           String           @db.VarChar(100)
  seats          Int
  zone           String           @db.VarChar(100)
  state          String           @default("Free") @db.VarChar(20)
  seated_at      DateTime?        @db.Timestamptz(6)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  platforms      platforms        @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_table_platform")
  orders         orders[]
  bookings       bookings[]
  table_requests table_requests[]

  @@map("tables")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id String        @db.Uuid
  table_id    String?       @db.Uuid
  code        String        @db.VarChar(30)
  table_name  String        @db.VarChar(100)
  total       Decimal       @default(0) @db.Decimal(12, 2)
  status      String        @db.VarChar(20)
  ts          DateTime      @default(now()) @db.Timestamptz(6)
  closed_ts   DateTime?     @db.Timestamptz(6)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  platforms   platforms     @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_platform")
  tables      tables?       @relation(fields: [table_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_order_table")
  order_lines order_lines[]

  @@unique([platform_id, code], map: "unique_order_code_per_platform")
}

model order_lines {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String     @db.Uuid
  item_id    String     @db.Uuid
  name       String     @db.VarChar(255)
  price      Decimal    @db.Decimal(12, 2)
  qty        Int
  note       String?
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  orders     orders     @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_line_order")
  menu_items menu_items @relation(fields: [item_id], references: [id], onUpdate: NoAction, map: "fk_order_line_item")
}

model bookings {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id String    @db.Uuid
  table_id    String?   @db.Uuid
  name        String    @db.VarChar(255)
  time        String    @db.VarChar(10)
  party       Int
  status      String    @default("Confirmed") @db.VarChar(20)
  date        DateTime  @db.Date
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  platforms   platforms @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_platform")
  tables      tables?   @relation(fields: [table_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_booking_table")
}

model table_requests {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_id String    @db.Uuid
  table_id    String?   @db.Uuid
  table_name  String    @db.VarChar(100)
  type        String    @db.VarChar(20)
  status      String    @default("pending") @db.VarChar(20)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at DateTime? @db.Timestamptz(6)

  platforms platforms @relation(fields: [platform_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_table_request_platform")
  tables    tables?   @relation(fields: [table_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_table_request_table")

  @@index([platform_id, status, created_at], map: "idx_table_request_queue")
}
