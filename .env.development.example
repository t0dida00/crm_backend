PORT=3000
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
JWT_SECRET="change-me"
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Encrypts businesses' own database URLs and Pusher secrets. 64 hex chars: openssl rand -hex 32
CREDENTIALS_KEY=
# false = every business must connect its own database and Pusher app
ALLOW_SHARED_INFRA=true
